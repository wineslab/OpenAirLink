##################################################
# RFNoC Block Sources - UPOLS FIR Filter
#
# Pipeline stages live in their own files for incremental bring-up:
#
#   axi_upols_osave_in   — sliding K-sample window builder
#   axi_upols_fft        — forward K-point FFT
#   axi_upols_mac        — frequency-domain MAC + circular FDL
#   axi_upols_ifft       — inverse  K-point FFT
#   axi_upols_osave_out  — overlap-save output extractor
#
# axi_upols_engine instantiates the five stages above in series.  Today
# the stages are AXI-Stream skid stubs (the block synthesizes and acts
# as a passthrough channel emulator).  When the Xilinx FFT IP wrappers
# and the MAC scheduler land they replace the stubs one at a time.
##################################################
RFNOC_OOT_SRCS += $(addprefix $(dir $(abspath $(lastword $(MAKEFILE_LIST)))), \
rfnoc_upols_regs.vh \
axi_upols_osave_in.v \
axi_upols_fft.v \
axi_upols_mac.v \
axi_upols_ifft.v \
axi_upols_osave_out.v \
axi_upols_engine.v \
rfnoc_block_upols.v \
noc_shell_upols.v \
)
